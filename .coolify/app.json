  },
  "volumes": {
    "note": "Reserved names for Paperclip — not yet attached in this PBI to avoid mount failure before Paperclip PBI lands; attach in Coolify → swedrip → Storages when Paperclip lands",
    "future": [
      { "source": "paperclip-data", "target": "/app/data", "type": "named volume" },
      { "source": "paperclip-workspace", "target": "/workspace", "type": "named volume" }
    ]
