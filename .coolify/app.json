      { "key": "OPENAI_API_KEY", "secret": true, "description": "Alias for OPENROUTER_API_KEY" },
      { "key": "OPENAI_BASE_URL", "secret": false, "value": "https://openrouter.ai/api/v1", "description": "OpenRouter base" },
      { "key": "DEFAULT_MODEL", "secret": false, "value": "anthropic/claude-sonnet-4-6", "description": "Default model" },
      { "key": "WORKSPACE_PATH", "secret": false, "value": "/workspace", "description": "Shared volume path" },
      { "key": "FOURTHWALL_MCP_TOKEN", "secret": true, "description": "FW MCP OAuth" },
      { "key": "TELEGRAM_BOT_TOKEN", "secret": true, "description": "Telegram bot token" },
      { "key": "TELEGRAM_CHAT_ID", "secret": true, "description": "Telegram chat id" },
      { "key": "LOOPS_API_KEY", "secret": true, "description": "Loops.so" },
      { "key": "BUFFER_ACCESS_TOKEN", "secret": true, "description": "Buffer" },
      { "key": "PLANE_API_KEY", "secret": true, "description": "Plane" }
    ]
  },
