# SWE Drip V1 — environment template.
# Copy to .env (never commit .env*) and replace every placeholder.
# Placeholders only; the secret scan in scripts/lint.js must stay green.

# ---- Datastores ----
DATABASE_URL=postgresql://swe_drip:replace-me@localhost:5432/swe_drip
POSTGRES_USER=swe_drip
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=swe_drip
POSTGRES_PORT=5432

# ---- Auth (Better Auth runtime; validated server-side by the API) ----
BETTER_AUTH_SECRET=replace-with-random-32-byte-hex
BETTER_AUTH_URL=http://localhost:3000
# Same-site API origin so session cookies flow to JSON AND images alike.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001

# ---- Dev auth bypass (PBI-057, local UI verification ONLY) ----
# Empty (default) = disabled. Set to an email to auto-auth as admin.
# NEVER set in production/Coolify: the API refuses to boot with
# APP_ENV=production while this is set.
# SWE_DRIP_DEV_AUTH_BYPASS=

# ---- Models (OpenRouter) ----
OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---- Storefront (Fourthwall MCP, OAuth2) ----
FOURTHWALL_MCP_URL=replace-with-fourthwall-mcp-url
FOURTHWALL_MCP_TOKEN=replace-with-oauth-token
