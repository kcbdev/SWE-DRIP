# SWE Drip V1 — FastAPI Control Panel API
# Multi-stage build: deps → production
# Exposed on port 8000 (uvicorn default)

# --- deps stage ---
FROM python:3.11-slim AS deps

WORKDIR /app

# System deps for psycopg[binary]
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc libpq-dev && \
    rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
# setuptools packages (api/, pipeline/) must exist before `pip install .`
COPY api/ ./api/
COPY pipeline/ ./pipeline/
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir .

# --- production stage ---
FROM python:3.11-slim AS production

WORKDIR /app

# Copy installed packages from deps stage
COPY --from=deps /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=deps /usr/local/bin /usr/local/bin

# Copy application source
COPY api/ ./api/
COPY pipeline/ ./pipeline/

# Create migrations directory (already in api/)
RUN mkdir -p /app/data/runs

EXPOSE 8000

# Run migrations on startup, then start uvicorn
# DIAGNOSTIC (revert to && once Coolify DB connectivity is proven): `;` lets
# uvicorn serve /api/health even when migrations cannot reach the database,
# isolating image/uvicorn crashes from DB-connectivity crashes.
CMD ["sh", "-c", "python -m api.app.migrations; echo MIGRATIONS_EXIT=$?; uvicorn api.app.main:app --host 0.0.0.0 --port 8000 --workers 2"]
