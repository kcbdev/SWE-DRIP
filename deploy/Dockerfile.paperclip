# Custom Paperclip image with hermes-local-plus adapter pre-installed
# Fixes: SOUL delivery, skills preservation, token tracking, wake context
FROM paperclipai/paperclip:latest

USER root

# Install the production-grade hermes adapter
RUN cd /app && npm install --legacy-peer-deps @felipefontoura/paperclip-adapter-hermes-local-plus || \
    cd /app && pnpm add -w @felipefontoura/paperclip-adapter-hermes-local-plus || \
    echo "WARN: adapter install failed, will need manual install"

# Ensure hermes home directory exists with proper ownership
RUN mkdir -p /home/hermes/.hermes && chown -R 1000:1000 /home/hermes/.hermes

# Back to default user
USER 1000:1000
